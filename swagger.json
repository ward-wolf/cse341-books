{
  "openapi": "3.0.0",
  "info": {
    "title": "Books API",
    "version": "1.0.0",
    "description": "A simple API for working with books"
  },
  "servers": [
    {
      "url": "/",
      "description": "Current server"
    }
  ],
  "paths": {
    "/books": {
      "get": {
        "tags": [
          "Books"
        ],
        "summary": "Get all books",
        "description": "Returns every book in the books collection.",
        "responses": {
          "200": {
            "description": "Books returned successfully.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Book"
                  }
                }
              }
            }
          },
          "500": {
            "description": "Unable to retrieve books.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "message": "Internal server error"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Books"
        ],
        "summary": "Create a book",
        "description": "Creates a book. The `authorId` must match the `id` of an existing author.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BookCreate"
              },
              "example": {
                "id": "b4",
                "authorId": "a1",
                "title": "Example Book Title",
                "publicationDate": "2026-01-15"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Book created successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Book"
                }
              }
            }
          },
          "400": {
            "description": "The request body is invalid or the authorId does not match an existing author. Only the first problem found is returned.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "examples": {
                  "invalidJson": {
                    "summary": "Body is not valid JSON",
                    "value": {
                      "message": "Request body must be valid JSON"
                    }
                  },
                  "notObject": {
                    "summary": "Body is not a JSON object",
                    "value": {
                      "message": "Request body must be a JSON object"
                    }
                  },
                  "unknownField": {
                    "summary": "Field is not allowed",
                    "value": {
                      "message": "Unknown field: _id"
                    }
                  },
                  "missingField": {
                    "summary": "Required field is missing",
                    "value": {
                      "message": "title is required"
                    }
                  },
                  "notString": {
                    "summary": "Field is not a string",
                    "value": {
                      "message": "title must be a string"
                    }
                  },
                  "tooLong": {
                    "summary": "Field is too long",
                    "value": {
                      "message": "title must be at most 200 characters"
                    }
                  },
                  "invalidDate": {
                    "summary": "publicationDate is not a valid date",
                    "value": {
                      "message": "publicationDate must be a valid date in YYYY-MM-DD format"
                    }
                  },
                  "unknownAuthor": {
                    "summary": "authorId does not match an author",
                    "value": {
                      "message": "authorId does not match an existing author"
                    }
                  }
                }
              }
            }
          },
          "409": {
            "description": "A book with this id already exists",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "message": "A book with this id already exists"
                }
              }
            }
          },
          "500": {
            "description": "Unable to create book",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "message": "Internal server error"
                }
              }
            }
          }
        }
      }
    },
    "/books/{id}": {
      "get": {
        "tags": [
          "Books"
        ],
        "summary": "Get a book by id",
        "description": "Returns the book whose `id` field matches the path parameter.",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "description": "The book's `id` field (not the MongoDB `_id`).",
            "schema": {
              "type": "string"
            },
            "example": "b1"
          }
        ],
        "responses": {
          "200": {
            "description": "Book returned successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Book"
                }
              }
            }
          },
          "404": {
            "description": "Book not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "message": "Book not found"
                }
              }
            }
          },
          "500": {
            "description": "Unable to retrieve book",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "message": "Internal server error"
                }
              }
            }
          }
        }
      },
      "put": {
        "tags": [
          "Books"
        ],
        "summary": "Update a book by id",
        "description": "Updates the book whose `id` field matches the path parameter. The `authorId` must match the `id` of an existing author.",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "description": "The book's `id` field (not the MongoDB `_id`).",
            "schema": {
              "type": "string"
            },
            "example": "b1"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BookUpdate"
              },
              "example": {
                "authorId": "a2",
                "title": "Updated Book Title",
                "publicationDate": "2026-02-20"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Book updated successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Book"
                }
              }
            }
          },
          "400": {
            "description": "The request body is invalid or the authorId does not match an existing author. Only the first problem found is returned, and body problems are reported before a missing book.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "examples": {
                  "invalidJson": {
                    "summary": "Body is not valid JSON",
                    "value": {
                      "message": "Request body must be valid JSON"
                    }
                  },
                  "notObject": {
                    "summary": "Body is not a JSON object",
                    "value": {
                      "message": "Request body must be a JSON object"
                    }
                  },
                  "idInBody": {
                    "summary": "Body contains id",
                    "value": {
                      "message": "id cannot be changed"
                    }
                  },
                  "unknownField": {
                    "summary": "Field is not allowed",
                    "value": {
                      "message": "Unknown field: isAdmin"
                    }
                  },
                  "missingField": {
                    "summary": "Required field is missing",
                    "value": {
                      "message": "publicationDate is required"
                    }
                  },
                  "notString": {
                    "summary": "Field is not a string",
                    "value": {
                      "message": "title must be a string"
                    }
                  },
                  "tooLong": {
                    "summary": "Field is too long",
                    "value": {
                      "message": "title must be at most 200 characters"
                    }
                  },
                  "invalidDate": {
                    "summary": "publicationDate is not a valid date",
                    "value": {
                      "message": "publicationDate must be a valid date in YYYY-MM-DD format"
                    }
                  },
                  "unknownAuthor": {
                    "summary": "authorId does not match an author",
                    "value": {
                      "message": "authorId does not match an existing author"
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Book not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "message": "Book not found"
                }
              }
            }
          },
          "500": {
            "description": "Unable to update book",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "message": "Internal server error"
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": [
          "Books"
        ],
        "summary": "Delete a book by id",
        "description": "Deletes the book whose `id` field matches the path parameter.",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "description": "The book's `id` field (not the MongoDB `_id`).",
            "schema": {
              "type": "string"
            },
            "example": "b1"
          }
        ],
        "responses": {
          "204": {
            "description": "Book deleted successfully"
          },
          "404": {
            "description": "Book not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "message": "Book not found"
                }
              }
            }
          },
          "500": {
            "description": "Unable to delete book",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "message": "Internal server error"
                }
              }
            }
          }
        }
      }
    },
    "/authors": {
      "get": {
        "summary": "Get all authors",
        "tags": [
          "Authors"
        ],
        "responses": {
          "200": {
            "description": "A list of authors"
          },
          "500": {
            "description": "Unable to retrieve authors"
          }
        }
      },
      "post": {
        "summary": "Create an author",
        "tags": [
          "Authors"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "id",
                  "name",
                  "birthYear"
                ],
                "properties": {
                  "id": {
                    "type": "string"
                  },
                  "name": {
                    "type": "string"
                  },
                  "birthYear": {
                    "type": "number"
                  }
                }
              },
              "example": {
                "id": "a4",
                "name": "Example Author",
                "birthYear": 1980
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Author created"
          },
          "400": {
            "description": "Missing required author fields or author ID already exists"
          },
          "500": {
            "description": "Unable to create author"
          }
        }
      }
    },
    "/authors/{id}": {
      "get": {
        "summary": "Get author by ID",
        "tags": [
          "Authors"
        ],
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "The author ID."
          }
        ],
        "responses": {
          "200": {
            "description": "A single author"
          },
          "404": {
            "description": "Author not found"
          },
          "500": {
            "description": "Unable to retrieve author"
          }
        }
      },
      "put": {
        "summary": "Update an author by ID",
        "tags": [
          "Authors"
        ],
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "The author ID."
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "name",
                  "birthYear"
                ],
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "birthYear": {
                    "type": "number"
                  }
                }
              },
              "example": {
                "name": "Updated Author",
                "birthYear": 1981
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Author updated"
          },
          "400": {
            "description": "Missing required author fields"
          },
          "404": {
            "description": "Author not found"
          },
          "500": {
            "description": "Unable to update author"
          }
        }
      },
      "delete": {
        "summary": "Delete an author by ID",
        "tags": [
          "Authors"
        ],
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "The author ID."
          }
        ],
        "responses": {
          "204": {
            "description": "Author deleted"
          },
          "404": {
            "description": "Author not found"
          },
          "409": {
            "description": "Author cannot be deleted because they still have books"
          },
          "500": {
            "description": "Unable to delete author"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Book": {
        "type": "object",
        "description": "A book document from the books collection.",
        "properties": {
          "_id": {
            "type": "string",
            "description": "MongoDB ObjectId assigned by the database.",
            "example": "6650f1a2b3c4d5e6f7a8b9c0"
          },
          "id": {
            "type": "string",
            "description": "Application-level book identifier used by GET /books/{id}.",
            "example": "b1"
          },
          "title": {
            "type": "string",
            "example": "The Hobbit"
          },
          "authorId": {
            "type": "string",
            "description": "The `id` of the book's author in the authors collection.",
            "example": "a1"
          },
          "publicationDate": {
            "type": "string",
            "format": "date",
            "description": "Publication date in YYYY-MM-DD format.",
            "example": "1937-09-21"
          }
        },
        "required": [
          "_id",
          "id",
          "title",
          "authorId",
          "publicationDate"
        ]
      },
      "BookCreate": {
        "type": "object",
        "description": "Request body for creating a book. No other fields are allowed.",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 20,
            "example": "b4"
          },
          "authorId": {
            "type": "string",
            "maxLength": 20,
            "description": "Must match the `id` of an existing author.",
            "example": "a1"
          },
          "title": {
            "type": "string",
            "maxLength": 200,
            "example": "Example Book Title"
          },
          "publicationDate": {
            "type": "string",
            "format": "date",
            "description": "A real calendar date in YYYY-MM-DD format.",
            "example": "2026-01-15"
          }
        },
        "required": [
          "id",
          "authorId",
          "title",
          "publicationDate"
        ]
      },
      "BookUpdate": {
        "type": "object",
        "description": "Request body for updating a book. Every field is required, and `id` cannot be changed.",
        "additionalProperties": false,
        "properties": {
          "authorId": {
            "type": "string",
            "maxLength": 20,
            "description": "Must match the `id` of an existing author.",
            "example": "a2"
          },
          "title": {
            "type": "string",
            "maxLength": 200,
            "example": "Updated Book Title"
          },
          "publicationDate": {
            "type": "string",
            "format": "date",
            "description": "A real calendar date in YYYY-MM-DD format.",
            "example": "2026-02-20"
          }
        },
        "required": [
          "authorId",
          "title",
          "publicationDate"
        ]
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string"
          }
        },
        "required": [
          "message"
        ]
      }
    }
  },
  "tags": [
    {
      "name": "Books",
      "description": "Create, read, update, and delete books in the books collection"
    }
  ]
}